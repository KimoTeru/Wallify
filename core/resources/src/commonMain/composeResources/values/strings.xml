<resources>
    <!-- Name of the app, shown on the splash and navigation screens and in the desktop window title -->
    <string name="app_name">Wallify</string>
    <!-- Confirm button of informational dialogs -->
    <string name="action_ok">OK</string>
    <!-- Button that repeats a failed request, shown under an error message and in the failure snackbar -->
    <string name="common_retry">Try again</string>
    <!-- Button of a filter dialog that applies the chosen values -->
    <string name="common_apply">Apply</string>
    <!-- Button of a filter dialog that clears the chosen values -->
    <string name="common_reset">Reset</string>
    <!-- Message of a photo list that has nothing to show -->
    <string name="common_photos_empty">No photos here yet</string>

    <!-- Title of the dialog shown when a request fails -->
    <string name="error_dialog_title">Something went wrong</string>
    <!-- Description of the dialog shown when a request fails -->
    <string name="error_dialog_description">Please try again later.</string>
    <!-- Banner at the top of the screen while the device has no internet connection; also the title of an error state -->
    <string name="error_no_internet">No internet connection</string>
    <!-- Description of an error state shown while the device is offline -->
    <string name="error_no_internet_description">Check your connection. The content loads again as soon as you are back online.</string>
    <!-- Title of an error state when the backend rejected the request parameters (HTTP 400) -->
    <string name="error_bad_request_title">Request not accepted</string>
    <!-- Error state description and failure snackbar for HTTP 400; %1$s is the HTTP status code -->
    <string name="error_bad_request_description">Error %1$s: the request was not accepted. Please try again.</string>
    <!-- Title of an error state when the session is not accepted (HTTP 401) -->
    <string name="error_unauthorized_title">Sign-in required</string>
    <!-- Error state description and failure snackbar for HTTP 401; %1$s is the HTTP status code -->
    <string name="error_unauthorized_description">Error %1$s: your session has expired. Please sign in again.</string>
    <!-- Title of an error state when the user has no rights for the action (HTTP 403) -->
    <string name="error_forbidden_title">Access denied</string>
    <!-- Error state description and failure snackbar for HTTP 403; %1$s is the HTTP status code -->
    <string name="error_forbidden_description">Error %1$s: you don't have permission to do this.</string>
    <!-- Title of an error state when the request limit of the backend is exhausted -->
    <string name="error_rate_limited_title">Request limit exceeded</string>
    <!-- Error state description and failure snackbar when the request limit is exhausted; %1$s is the HTTP status code -->
    <string name="error_rate_limited_description">Error %1$s: request limit exceeded. Please try again later.</string>
    <!-- Title of an error state when the requested item does not exist (HTTP 404) -->
    <string name="error_not_found_title">Not found</string>
    <!-- Error state description and failure snackbar for HTTP 404; %1$s is the HTTP status code -->
    <string name="error_not_found_description">Error %1$s: nothing was found. It may have been removed.</string>
    <!-- Title of an error state when the backend failed (HTTP 5xx) -->
    <string name="error_server_title">Server error</string>
    <!-- Error state description and failure snackbar for HTTP 5xx; %1$s is the HTTP status code -->
    <string name="error_server_description">Error %1$s: the server is not responding. Please try again later.</string>
    <!-- Error state description and failure snackbar for any other HTTP status; %1$s is the HTTP status code -->
    <string name="error_unknown_description">Error %1$s: something went wrong. Please try again later.</string>
    <!-- Failure snackbar of adding or removing a photo: the collection belongs to someone else (HTTP 403) -->
    <string name="error_collection_forbidden">You can only change your own collections.</string>
    <!-- Failure snackbar of adding or removing a photo: the collection or the photo no longer exists (HTTP 404) -->
    <string name="error_collection_not_found">This collection or photo no longer exists.</string>
    <!-- Failure snackbar of saving the profile: some fields were not accepted (HTTP 400 or 422) -->
    <string name="error_profile_invalid">Some fields were not accepted. Check them and try again.</string>
    <!-- Failure snackbar of saving the profile: the session has no right to change the profile (HTTP 403) -->
    <string name="error_profile_forbidden">The app has no permission to change your profile. Sign in again.</string>
    <!-- Failure snackbar of the sign-in: the backend did not accept the code from the browser (HTTP 400) -->
    <string name="error_auth_code_rejected">The sign-in was not completed. Please try again.</string>
    <!-- Failure snackbar of the sign-in: the backend did not accept the app itself (HTTP 401) -->
    <string name="error_auth_client_rejected">The photo service did not accept the app. Sign-in is not available.</string>

    <!-- Legal consent text; %1$s, %2$s and %3$s are the link names below, in this order -->
    <string name="legal_consent">By continuing, you accept our %1$s, %2$s and %3$s.</string>
    <!-- Link name inside the legal consent text -->
    <string name="legal_terms_of_service">Terms of Service</string>
    <!-- Link name inside the legal consent text -->
    <string name="legal_privacy_policy">Privacy Policy</string>
    <!-- Link name inside the legal consent text -->
    <string name="legal_subscription_terms">Subscription Terms</string>

    <!-- Permission name inside the denied-access dialog title -->
    <string name="permission_camera">Camera</string>
    <!-- Permission name inside the denied-access dialog title -->
    <string name="permission_notifications">Notifications</string>
    <!-- Title of the denied-access dialog; %1$s is the permission name -->
    <string name="permission_denied_title">No access to %1$s</string>
    <!-- Description of the denied camera access dialog -->
    <string name="permission_camera_description">Please allow camera access to continue.</string>
    <!-- Description of the denied notifications access dialog -->
    <string name="permission_notifications_description">Please allow notification access to stay updated.</string>
    <!-- Button of the denied-access dialog that opens the app settings -->
    <string name="permission_allow_access">Allow access</string>

    <!-- Headline of the sign-in screen, which the app shows until the user is signed in -->
    <string name="auth_title">Welcome to Wallify</string>
    <!-- Description under the headline of the sign-in screen -->
    <string name="auth_description">Sign in with your Unsplash account to browse wallpapers, collect your favorites and download photos.</string>
    <!-- Button of the sign-in screen that opens the sign-in page of the photo service in the browser -->
    <string name="auth_sign_in">Sign in with Unsplash</string>
    <!-- Button of the settings screen that signs the user out -->
    <string name="auth_sign_out">Sign out</string>
    <!-- Sign-in screen text while the sign-in page is open in the browser and the app waits for the user -->
    <string name="auth_waiting_for_browser">Finish signing in in your browser</string>
    <!-- Button of the sign-in screen that stops waiting for the sign-in in the browser -->
    <string name="auth_cancel">Cancel</string>

    <!-- Main navigation: the editorial photo feed with search; also the title of that screen -->
    <string name="nav_feed">All photos</string>
    <!-- Main navigation: photos grouped by topic; also the title of that screen -->
    <string name="nav_topics">Curated</string>
    <!-- Main navigation: random photos; also the title of that screen -->
    <string name="nav_random">Random</string>
    <!-- Main navigation: the profile of the signed-in user -->
    <string name="nav_studio">Studio</string>
    <!-- Main navigation: the settings screen; also the title of that screen -->
    <string name="nav_settings">Settings</string>

    <!-- Hint of the search field above the photo feed -->
    <string name="feed_search_hint">Search photos</string>
    <!-- Title of the search filters sheet and dialog -->
    <string name="feed_filters_title">Search filters</string>
    <!-- Note under the title of the search filters: they work only together with a search text -->
    <string name="feed_filters_note">Filters apply to search results.</string>
    <!-- Section of the search filters: orientation of the photo -->
    <string name="feed_filter_orientation">Orientation</string>
    <!-- Section of the search filters: dominant color of the photo -->
    <string name="feed_filter_color">Color</string>
    <!-- Section of the search filters: order of the results -->
    <string name="feed_filter_order">Sort by</string>
    <!-- Section of the search filters: filter of content unsuitable for younger audiences -->
    <string name="feed_filter_content">Content filter</string>
    <!-- Photo orientation -->
    <string name="orientation_landscape">Landscape</string>
    <!-- Photo orientation -->
    <string name="orientation_portrait">Portrait</string>
    <!-- Photo orientation: width equals height -->
    <string name="orientation_squarish">Squarish</string>
    <!-- Photo color filter value -->
    <string name="color_black_and_white">Black and white</string>
    <!-- Photo color filter value -->
    <string name="color_black">Black</string>
    <!-- Photo color filter value -->
    <string name="color_white">White</string>
    <!-- Photo color filter value -->
    <string name="color_yellow">Yellow</string>
    <!-- Photo color filter value -->
    <string name="color_orange">Orange</string>
    <!-- Photo color filter value -->
    <string name="color_red">Red</string>
    <!-- Photo color filter value -->
    <string name="color_purple">Purple</string>
    <!-- Photo color filter value -->
    <string name="color_magenta">Magenta</string>
    <!-- Photo color filter value -->
    <string name="color_green">Green</string>
    <!-- Photo color filter value -->
    <string name="color_teal">Teal</string>
    <!-- Photo color filter value -->
    <string name="color_blue">Blue</string>
    <!-- Order of search results: the best match first -->
    <string name="order_relevant">Relevant</string>
    <!-- Order of search results: the newest first -->
    <string name="order_latest">Latest</string>
    <!-- Content filter value: the backend default -->
    <string name="content_filter_low">Standard</string>
    <!-- Content filter value: removes content that may be unsuitable for younger audiences -->
    <string name="content_filter_high">Strict</string>

    <!-- Button of the random photos screen that loads another set of photos -->
    <string name="random_shuffle">Refresh</string>

    <!-- Attribution under the photo; %1$s is the name of the photographer, who is a link to the profile -->
    <string name="photo_attribution">Photo by %1$s on Unsplash</string>
    <!-- Button that opens the photo page of the photo service in the browser -->
    <string name="photo_open_source">Open on Unsplash</string>
    <!-- Button that downloads the photo through the browser -->
    <string name="photo_download">Download</string>
    <!-- Size of a photo in pixels; %1$d is the width, %2$d is the height -->
    <string name="photo_dimensions">%1$d × %2$d px</string>
    <!-- Section title: camera data of a photo -->
    <string name="photo_exif_title">Camera data</string>
    <!-- Label of the camera of a photo -->
    <string name="photo_exif_camera">Camera</string>
    <!-- Label of the aperture of a photo -->
    <string name="photo_exif_aperture">Aperture</string>
    <!-- Label of the shutter speed of a photo -->
    <string name="photo_exif_exposure">Shutter</string>
    <!-- Label of the ISO sensitivity of a photo -->
    <string name="photo_exif_iso">ISO</string>
    <!-- Label of the focal length of a photo -->
    <string name="photo_exif_focal">Focal length</string>
    <!-- Aperture value; %1$s is the f-number, e.g. 1.8 -->
    <string name="photo_exif_aperture_value">ƒ/%1$s</string>
    <!-- Shutter speed value; %1$s is the exposure time in seconds, e.g. 1/2000 -->
    <string name="photo_exif_exposure_value">%1$s s</string>
    <!-- Focal length value; %1$s is the length in millimeters -->
    <string name="photo_exif_focal_value">%1$s mm</string>
    <!-- Message when the photographer shared no camera data -->
    <string name="photo_exif_empty">The photographer did not share camera data.</string>
    <!-- Section title: tags of a photo -->
    <string name="photo_tags">Tags</string>
    <!-- Section title: views and downloads of a photo for the last days -->
    <string name="photo_stats_title">Last 30 days</string>
    <!-- Caption of the number of views -->
    <string name="photo_stats_views">Views</string>
    <!-- Caption of the number of downloads -->
    <string name="photo_stats_downloads">Downloads</string>
    <!-- Section title: collections of the signed-in user, where the photo can be added or removed -->
    <string name="photo_collections_title">Your collections</string>
    <!-- Message when the signed-in user has no collections -->
    <string name="photo_collections_empty">You have no collections yet.</string>

    <!-- Tab of the profile: photos of the user -->
    <string name="profile_tab_photos">Photos</string>
    <!-- Tab of the profile: collections of the user -->
    <string name="profile_tab_collections">Collections</string>
    <!-- Caption of the number of photos of the user -->
    <string name="profile_stat_photos">Photos</string>
    <!-- Caption of the number of collections of the user -->
    <string name="profile_stat_collections">Collections</string>
    <!-- Caption of the number of downloads of the user's photos -->
    <string name="profile_stat_downloads">Downloads</string>
    <!-- Message when the user has no collections -->
    <string name="profile_collections_empty">No collections yet</string>
    <!-- Number of photos of a collection; %1$d is the number -->
    <string name="profile_collection_photos">%1$d photos</string>
    <!-- Button that leaves the photos of a collection and returns to the list of collections -->
    <string name="profile_collection_back">All collections</string>
    <!-- Button on the own profile: opens the form to change the profile -->
    <string name="profile_edit">Edit profile</string>
    <!-- Button on the own profile: opens the photo service's page for uploading photos in the browser -->
    <string name="profile_upload">Upload photo</string>
    <!-- Title of the form to change the own profile -->
    <string name="profile_edit_title">Edit profile</string>
    <!-- Field of the profile form: username -->
    <string name="profile_edit_username">Username</string>
    <!-- Field of the profile form: first name -->
    <string name="profile_edit_first_name">First name</string>
    <!-- Field of the profile form: last name -->
    <string name="profile_edit_last_name">Last name</string>
    <!-- Field of the profile form: email address -->
    <string name="profile_edit_email">Email</string>
    <!-- Field of the profile form: address of the personal website or portfolio -->
    <string name="profile_edit_portfolio">Website</string>
    <!-- Field of the profile form: where the user lives -->
    <string name="profile_edit_location">Location</string>
    <!-- Field of the profile form: short text about the user -->
    <string name="profile_edit_bio">About you</string>
    <!-- Field of the profile form: Instagram username without the at sign -->
    <string name="profile_edit_instagram">Instagram username</string>
    <!-- Button of the profile form: saves the changes -->
    <string name="profile_edit_save">Save</string>

    <!-- Section title of the settings: the signed-in account -->
    <string name="settings_account">Account</string>
    <!-- Section title of the settings: look of the app -->
    <string name="settings_appearance">Appearance</string>
    <!-- Choice of the color scheme: follows the device -->
    <string name="settings_theme_system">System</string>
    <!-- Choice of the color scheme: dark -->
    <string name="settings_theme_night">Night</string>
    <!-- Choice of the color scheme: light -->
    <string name="settings_theme_day">Day</string>
    <!-- Section title of the settings: arrangement of the whole screen (navigation, panels, columns) -->
    <string name="settings_screen_layout">Screen layout</string>
    <!-- Choice of the screen layout: follows the window size -->
    <string name="settings_screen_layout_auto">Auto</string>
    <!-- Choice of the screen layout: the phone arrangement with the bottom dock -->
    <string name="settings_screen_layout_compact">Compact</string>
    <!-- Choice of the screen layout: the tablet arrangement with the side rail -->
    <string name="settings_screen_layout_medium">Medium</string>
    <!-- Choice of the screen layout: the desktop arrangement with the permanent drawer -->
    <string name="settings_screen_layout_expanded">Expanded</string>
    <!-- Note under the screen layout choice -->
    <string name="settings_screen_layout_description">Compact is the phone layout, Medium the tablet one, Expanded the desktop one. Auto follows the window size.</string>
    <!-- Section title of the settings: default layout of the photo lists -->
    <string name="settings_layout">Photo layout</string>
    <!-- Choice of the photo layout: cards keep the proportions of their photos -->
    <string name="settings_layout_masonry">Masonry</string>
    <!-- Choice of the photo layout: all cards have the same size -->
    <string name="settings_layout_grid">Grid</string>
    <!-- Choice of the photo layout: large cards in one column -->
    <string name="settings_layout_list">List</string>
    <!-- Label of the choice of the number of photo columns -->
    <string name="settings_columns">Columns</string>
    <!-- Choice of the number of photo columns: the window width decides -->
    <string name="settings_columns_auto">Auto</string>
    <!-- Note under the photo layout choice: where it applies -->
    <string name="settings_layout_description">Applies to the photo feed. Curated, random photos and profiles always use a grid of equal cards.</string>
    <!-- Section title of the settings: language of the app -->
    <string name="settings_language">Language</string>
    <!-- Note under the language choice: what the language changes -->
    <string name="settings_language_description">Language of the app and of your photo search queries. Search in languages other than English is a beta feature of the photo service and may not work for every app.</string>
    <!-- Section title of the settings: quality of the images -->
    <string name="settings_image_quality">Image quality</string>
    <!-- Label of the choice of the image quality in photo lists -->
    <string name="settings_image_quality_list">In lists</string>
    <!-- Label of the choice of the image quality on the photo screen -->
    <string name="settings_image_quality_detail">Photo screen</string>
    <!-- Label of the choice of the quality of the downloaded file -->
    <string name="settings_image_quality_download">Download</string>
    <!-- Choice of the image quality: the smallest file, loads fastest -->
    <string name="settings_image_quality_low">Low</string>
    <!-- Choice of the image quality: a small file with fair detail -->
    <string name="settings_image_quality_medium">Medium</string>
    <!-- Choice of the image quality: a large file with good detail -->
    <string name="settings_image_quality_high">High</string>
    <!-- Choice of the image quality: the original file, the largest -->
    <string name="settings_image_quality_original">Original</string>
    <!-- Note under the image quality choice: what higher quality costs -->
    <string name="settings_image_quality_description">Higher quality takes more traffic, time and memory. Lists and the photo screen first show a small version of the photo, then the chosen one.</string>
    <!-- Section title of the settings: requests the app sent to the photo service -->
    <string name="settings_requests_title">Requests of the app</string>
    <!-- Caption of the number of all requests the app sent since the last reset -->
    <string name="settings_requests_total">Requests</string>
    <!-- Caption of the number of requests left in the current hour -->
    <string name="settings_requests_remaining">Left this hour</string>
    <!-- Value of the requests left: %1$s is how many are left, %2$s is the hourly limit -->
    <string name="settings_requests_remaining_value">%1$s of %2$s</string>
    <!-- Value of the requests left before the first answer of the photo service -->
    <string name="settings_requests_remaining_unknown">—</string>
    <!-- Label over the chart of requests per day for the last 30 days -->
    <string name="settings_requests_days_title">Last 30 days</string>
    <!-- Sum of the requests in the last 30 days next to the chart label: %1$s is the number of requests -->
    <string name="settings_requests_days_total">%1$s in total</string>
    <!-- Caption over the chart of requests per day: %1$s is the largest number of requests in one day -->
    <string name="settings_requests_days_max">Up to %1$s a day</string>
    <!-- Caption under the first (left) bar of the chart of requests per day -->
    <string name="settings_requests_days_start">30 days ago</string>
    <!-- Caption under the last (right, highlighted) bar of the chart of requests per day -->
    <string name="settings_requests_days_end">Today</string>
    <!-- Accessibility description of the chart: %1$s is the sum for 30 days, %2$s is the largest number in one day -->
    <string name="settings_requests_days_description">Requests per day for the last 30 days: %1$s in total, up to %2$s a day</string>
    <!-- Label over the list of the most requested endpoints -->
    <string name="settings_requests_top">Most requested</string>
    <!-- Count of one endpoint: %1$s is the number of requests, %2$s is its share of all requests in percent -->
    <string name="settings_requests_share">%1$s · %2$s%</string>
    <!-- Shown instead of the list of endpoints when nothing was requested yet -->
    <string name="settings_requests_empty">No requests yet</string>
    <!-- Button that sets the request counters to zero -->
    <string name="settings_requests_reset">Reset statistics</string>
    <!-- Note under the request statistics: where they are counted and where the limit comes from -->
    <string name="settings_requests_description">Counted on this device since the last reset or sign-out. The photo service allows a limited number of requests per hour, how many are left comes with every answer.</string>
    <!-- Section title of the settings: about the photo source -->
    <string name="settings_about">About</string>
    <!-- Text of the about section: all photos come from the photo service -->
    <string name="settings_about_description">All photos are provided by Unsplash and belong to their photographers.</string>
</resources>