{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch --show-current:*)",
      "Bash(git ls-files:*)"
    ],
    "deny": [
      "Bash(./gradlew:*)",
      "Bash(gradle:*)",
      "Bash(git push:*)"
    ]
  }
}