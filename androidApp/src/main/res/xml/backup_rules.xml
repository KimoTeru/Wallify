<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 and lower: the same as `data_extraction_rules.xml`. Android 11 ignores `allowBackup="false"` for a
    device-to-device transfer, so the files are excluded here too.
    https://developer.android.com/identity/data/autobackup#include-exclude-android-11
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="external" path="." />
</full-backup-content>